# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB URI.
# If left empty or set to "memory", an in-memory MongoDB instance will be used for seamless local development and tests.
MONGODB_URI=mongodb://localhost:27017/smart_wall_paint_visualizer

# JWT Security
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789!
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Default Admin Seed Configuration (Used only when running db seed)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@wallvisualizer.com
ADMIN_PASSWORD=Admin@123456
